# Sovereign multi-agent kit — environment file template
# Copy to .env and fill in. Never commit .env.

# --- OpenRouter (primary LLM access for managers + workers) ---
OPENROUTER_API_KEY=

# --- Telegram bot (Operator interface) ---
# Get a token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
# Your Telegram numeric chat ID (talk to @userinfobot to get yours)
TELEGRAM_OPERATOR_CHAT_ID=

# --- Ollama (Hermes runtime) ---
# Defaults are usually fine
OLLAMA_URL=http://127.0.0.1:11434/api/chat
OLLAMA_MODEL=kimi-k2-0905

# --- OpenClaw (optional dispatch layer) ---
# OPENCLAW_MODE = off | cli | http
OPENCLAW_MODE=off
# If cli: command template; placeholders: {model} {sys_file} {usr_file}
OPENCLAW_CMD=openclaw chat --model {model} --system-file {sys_file} --user-file {usr_file}
# If http: endpoint accepting {"model":"...","system":"...","user":"..."}
OPENCLAW_URL=
OPENCLAW_KEY=

# --- Operator profile (used in scoring + memory) ---
OPERATOR_NAME=
# 2-letter US state code; affects RE wholesale Compliance gate
OPERATOR_STATE=
